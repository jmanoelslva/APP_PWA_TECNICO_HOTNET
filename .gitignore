# Backend (Python)
backend/.venv/
backend/**/__pycache__/
backend/.env
# $HOME do usuário de sistema do serviço (deploy/install.sh) aponta pra
# backend/ — pip cria esse cache aí; sem isso, "git status --porcelain"
# no install.sh acusaria "alteração local" a cada atualização.
backend/.cache/

# Frontend (Node/Vite)
frontend/node_modules/
frontend/dist/
frontend/dev-dist/
frontend/.vite/

# Editor/OS
.idea/
.vscode/
*.log
Thumbs.db
