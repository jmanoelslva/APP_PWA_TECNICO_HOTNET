CONTROLLR_URL=https://controllr.hotnet.net.br:8443
SESSION_COOKIE_MAX_AGE_SECONDS=86400
CONTROLLR_LIVENESS_CHECK_SECONDS=60
CORS_ALLOW_ORIGINS=http://localhost:5173
IPIFY_API_KEY=
# Auditoria: usuários do Controllr que podem consultá-la no app (vírgula; "*" ou "todos" = todos); meses guardados.
AUDITORIA_USUARIOS=
AUDITORIA_RETENCAO_MESES=12
# Avisos de OS nova no celular (o deploy/install.sh preenche). Sem usuário de
# consulta ou sem chaves VAPID, os avisos ficam desligados.
CONTROLLR_CONSULTA_USUARIO=
CONTROLLR_CONSULTA_SENHA=
AVISOS_INTERVALO_SEGUNDOS=60
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTATO=mailto:suporte@hotnet.net.br
